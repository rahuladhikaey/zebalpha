# ==============================================================================
# ZEBALPHA — SELLER DASHBOARD ENVIRONMENT TEMPLATE
# DO NOT COMMIT REAL VALUES TO VERSION CONTROL.
# Copy this file to .env.local for local development.
# ==============================================================================

# Public URLs & Backend Endpoints
NEXT_PUBLIC_SITE_URL=http://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:3001
NEXT_PUBLIC_STOREFRONT_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:5000
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Razorpay Integration
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_yourKeyId
RAZORPAY_KEY_ID=rzp_test_yourKeyId
RAZORPAY_KEY_SECRET=your-razorpay-key-secret

# Logistics & Bank Encryption Key
SHIPROCKET_EMAIL=logistics@yourdomain.com
SHIPROCKET_PASSWORD=your-shiprocket-password
BANK_ENCRYPTION_KEY=your-32-character-bank-vault-encryption-key
