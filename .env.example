# ==============================================================================
# ZEBALPHA — ROOT ENVIRONMENT TEMPLATE
# DO NOT COMMIT REAL VALUES TO VERSION CONTROL.
# Copy this file to .env or .env.local for local development.
# ==============================================================================

# Server & Runtime Configuration
PORT=5000
NODE_ENV=development
API_BASE_URL=http://localhost:5000
NEXT_PUBLIC_API_URL=http://localhost:5000
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SELLER_URL=http://localhost:3001
NEXT_PUBLIC_ADMIN_URL=http://localhost:3002

# PostgreSQL Direct Connection (Supabase Pooler)
DATABASE_URL=postgresql://postgres.your-project-id:your-db-password@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
DIRECT_URL=postgresql://postgres.your-project-id:your-db-password@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
POSTGRES_URL=postgresql://postgres.your-project-id:your-db-password@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
DB_HOST=aws-0-ap-south-1.pooler.supabase.com
DB_PORT=5432
DB_NAME=postgres
DB_DATABASE=postgres
DB_USER=postgres.your-project-id
DB_PASSWORD=your-db-password

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Single Unified DB aliases
SUPABASE_A_URL=https://your-project-id.supabase.co
SUPABASE_A_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_A_ANON_KEY=your-supabase-anon-key
SUPABASE_B_URL=https://your-project-id.supabase.co
SUPABASE_B_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_B_ANON_KEY=your-supabase-anon-key

# Authentication & Cryptography
JWT_SECRET=your-secure-jwt-signing-secret
JWT_REFRESH_SECRET=your-secure-jwt-refresh-secret
ADMIN_JWT_SECRET=your-secure-admin-jwt-secret
ADMIN_ACCESS_KEY_1=your-admin-access-key-1
ADMIN_ACCESS_KEY_2=your-admin-access-key-2
CRON_SECRET=your-secure-cron-trigger-secret

# Razorpay Standard & RazorpayX Payouts
RAZORPAY_KEY_ID=rzp_test_yourKeyId
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_yourKeyId
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret
RAZORPAY_ACCOUNT_NUMBER=your-razorpayx-account-number

# Logistics (Shiprocket)
SHIPROCKET_EMAIL=logistics@yourdomain.com
SHIPROCKET_PASSWORD=your-shiprocket-password
SHIPROCKET_WEBHOOK_SECRET=your-shiprocket-webhook-secret

# Cloudinary CDN & Upstash Redis Cache (Optional)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-key
CLOUDINARY_API_SECRET=your-cloudinary-secret
CLOUDINARY_UPLOAD_PRESET=your-preset
UPSTASH_REDIS_REST_URL=https://your-redis-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token
REDIS_URL=rediss://default:your-token@your-redis-instance.upstash.io:6379
