# ZEBALPHA — PRODUCTION ENVIRONMENT VARIABLES SCHEMA
# Do NOT commit actual secrets to version control.

NODE_ENV=production
PORT=5000

# Supabase Databases
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Upstash Redis Caching Layer
UPSTASH_REDIS_REST_URL=https://your-upstash-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token
CACHE_TTL_PRODUCTS=300
CACHE_TTL_CATEGORIES=1800
CACHE_TTL_PRODUCT_DETAIL=600

# Payment Gateway (Razorpay)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Shipping & Logistics (Shiprocket)
SHIPROCKET_EMAIL=your_shiprocket_email
SHIPROCKET_PASSWORD=your_shiprocket_password
SHIPROCKET_API_TOKEN=your_shiprocket_api_token

# Platform & CORS Config
FRONTEND_URL=https://zebalpha.com
SELLER_FRONTEND_URL=https://seller.zebalpha.com
SUPERADMIN_FRONTEND_URL=https://admin.zebalpha.com

# AI Virtual Try-On (VTO) Configuration
# Supported providers: 'replicate' | 'fashn' | 'fal' | 'mock'
VIRTUAL_TRYON_PROVIDER=replicate
VIRTUAL_TRYON_API_KEY=your_virtual_tryon_api_key_here
VIRTUAL_TRYON_MODEL=cuuupid/idm-vton:c871bb9b046607b680486f0690f3c443d6f794da9199cf8618b3240b2d422a83
VIRTUAL_TRYON_TIMEOUT=60000
