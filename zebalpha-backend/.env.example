PORT=5000
NODE_ENV=development
API_BASE_URL=https://api.asaliswad.com

# PostgreSQL Direct Database Connection (Supabase Pooler)
DATABASE_URL=postgresql://postgres.your-project-ref:your-password@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
DIRECT_URL=postgresql://postgres.your-project-ref:your-password@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
DB_HOST=aws-0-ap-south-1.pooler.supabase.com
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres.your-project-ref
DB_PASSWORD=your-password

# Supabase Instance A: Customer Storefront, Super Admin, Products, Orders, Payments, Reviews
SUPABASE_A_URL=https://your-supabase-a.supabase.co
SUPABASE_A_SERVICE_ROLE_KEY=your-supabase-a-service-role-key
SUPABASE_A_ANON_KEY=your-supabase-a-anon-key

# Supabase Instance B: Seller Auth & Profile, Inventory, Pickup Locations, Reports, Audit Logs
SUPABASE_B_URL=https://your-supabase-b.supabase.co
SUPABASE_B_SERVICE_ROLE_KEY=your-supabase-b-service-role-key
SUPABASE_B_ANON_KEY=your-supabase-b-anon-key

# Third Party Integrations
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
SHIPROCKET_EMAIL=your_shiprocket_email
SHIPROCKET_PASSWORD=your_shiprocket_password
BREVO_API_KEY=your_brevo_api_key
CLOUDINARY_CLOUD_NAME=p1ish280
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# AI Virtual Try-On (VTO) Configuration
# Supported providers: 'replicate' | 'fashn' | 'fal' | 'mock'
VIRTUAL_TRYON_PROVIDER=replicate
VIRTUAL_TRYON_API_KEY=your_replicate_or_fashn_or_fal_api_key
VIRTUAL_TRYON_MODEL=cuuupid/idm-vton:c871bb9b046607b680486f0690f3c443d6f794da9199cf8618b3240b2d422a83
VIRTUAL_TRYON_TIMEOUT=60000
