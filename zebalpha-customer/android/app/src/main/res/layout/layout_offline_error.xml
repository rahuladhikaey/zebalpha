<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layout_offline_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:clickable="true"
    android:focusable="true"
    android:fitsSystemWindows="true">

    <!-- Center Content matching Target Design -->
    <LinearLayout
        android:id="@+id/ll_offline_center"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="48dp">

        <!-- Modern Disconnected Cloud + Phone Illustration -->
        <ImageView
            android:id="@+id/iv_error_illustration"
            android:layout_width="160dp"
            android:layout_height="160dp"
            android:src="@drawable/ic_network_error_illustration"
            android:contentDescription="No connection" />

        <!-- Title: "No connection" -->
        <TextView
            android:id="@+id/tv_error_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:text="No connection"
            android:textColor="#202124"
            android:textSize="20sp"
            android:fontFamily="sans-serif-medium"
            android:textStyle="bold" />

        <!-- Subtitle: "Please check your internet connectivity and try again" -->
        <TextView
            android:id="@+id/tv_error_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:gravity="center"
            android:text="Please check your internet connectivity\nand try again"
            android:textColor="#5F6368"
            android:textSize="14sp"
            android:lineSpacingExtra="3dp"
            android:fontFamily="sans-serif" />

        <!-- Retry Button Container with Loading Spinner -->
        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp">

            <Button
                android:id="@+id/btn_error_retry"
                android:layout_width="120dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_retry_button"
                android:text="Retry"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:elevation="0dp"
                android:stateListAnimator="@null" />

            <ProgressBar
                android:id="@+id/pb_error_retry"
                style="?android:attr/progressBarStyleSmall"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:indeterminate="true"
                android:indeterminateTint="#FFFFFF"
                android:visibility="gone" />

        </FrameLayout>

    </LinearLayout>

    <!-- Bottom Navigation Skeleton Bar matching Target Design -->
    <LinearLayout
        android:id="@+id/ll_bottom_skeleton_bar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_alignParentBottom="true"
        android:orientation="vertical"
        android:background="#FFFFFF">

        <!-- Subtle Top Divider Line -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#F1F3F4" />

        <!-- 5 Skeleton Tab Columns (Home, Categories, Wishlist, Account, Cart) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:orientation="horizontal"
            android:weightSum="5">

            <!-- Tab 1 Skeleton -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <View
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:background="@drawable/bg_skeleton_circle" />

                <View
                    android:layout_width="34dp"
                    android:layout_height="8dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_skeleton_pill" />
            </LinearLayout>

            <!-- Tab 2 Skeleton -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <View
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:background="@drawable/bg_skeleton_circle" />

                <View
                    android:layout_width="34dp"
                    android:layout_height="8dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_skeleton_pill" />
            </LinearLayout>

            <!-- Tab 3 Skeleton -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <View
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:background="@drawable/bg_skeleton_circle" />

                <View
                    android:layout_width="34dp"
                    android:layout_height="8dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_skeleton_pill" />
            </LinearLayout>

            <!-- Tab 4 Skeleton -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <View
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:background="@drawable/bg_skeleton_circle" />

                <View
                    android:layout_width="34dp"
                    android:layout_height="8dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_skeleton_pill" />
            </LinearLayout>

            <!-- Tab 5 Skeleton -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <View
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:background="@drawable/bg_skeleton_circle" />

                <View
                    android:layout_width="34dp"
                    android:layout_height="8dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_skeleton_pill" />
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</RelativeLayout>